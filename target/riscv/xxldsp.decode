# Fields:
%rs3        27:5
%rs2        20:5
%rs1        15:5
%rd         7:5
%sh3        20:3
%sh4        20:4
%sh5        20:5
%sh6        20:6

# Argument sets
&r    rd rs1 rs2  !extern
&r2   rd rs1      !extern
&r4   rd rs1 rs2 rs3
&shift     shamt rs1 rd     !extern

# Formats
@r       .......   ..... ..... ... ..... ....... &r         %rs2 %rs1 %rd
@r2      .......   ..... ..... ... ..... ....... &r2        %rs1 %rd
