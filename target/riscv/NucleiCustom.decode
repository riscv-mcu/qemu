# Fields:

%rs2       20:5
%rs1       15:5
%rd        7:5
%sh5       20:5

# Argument sets
&r    rd rs1 rs2  !extern
&r2   rd rs1      !extern
&shift     shamt rs1 rd     !extern

# Formats
@r       .......   ..... ..... ... ..... ....... &r         %rs2 %rs1 %rd
@r2      .......   ..... ..... ... ..... ....... &r2        %rs1 %rd
@sh5     .......  ..... .....  ... ..... ....... &shift     shamt=%sh5      %rs1 %rd


