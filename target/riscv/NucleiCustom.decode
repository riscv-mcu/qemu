# Fields:

%rs2       20:5
%rs1       15:5
%rd        7:5

# Argument sets
&r    rd rs1 rs2  !extern
&r2   rd rs1      !extern

# Formats
@r       .......   ..... ..... ... ..... ....... &r         %rs2 %rs1 %rd
@r2      .......   ..... ..... ... ..... ....... &r2        %rs1 %rd


# *** Nuclei Default SIMD DSP Additional Instruction ***
expd80          0010010 00000  ..... 111 ..... 1111111 @r2
expd81          0010010 00001  ..... 111 ..... 1111111 @r2
expd82          0010010 00010  ..... 111 ..... 1111111 @r2
expd83          0010010 00011  ..... 111 ..... 1111111 @r2
expd84          0010010 00100  ..... 111 ..... 1111111 @r2
expd85          0010010 00101  ..... 111 ..... 1111111 @r2
expd86          0010010 00110  ..... 111 ..... 1111111 @r2
expd87          0010010 00111  ..... 111 ..... 1111111 @r2

# *** Nuclei N1 SIMD DSP Additional Instruction ***
dkhm8           1000111 .....  ..... 111 ..... 1111111 @r
dkhm16          1000011 .....  ..... 111 ..... 1111111 @r
dkabs8          1010110 10000  ..... 111 ..... 1111111 @r2
dkabs16         1010110 10001  ..... 111 ..... 1111111 @r2
dkslra8         0101111 .....  ..... 111 ..... 1111111 @r
dkslra16        0101011 .....  ..... 111 ..... 1111111 @r
dkadd8          0001100 .....  ..... 111 ..... 1111111 @r
dkadd16         0001000 .....  ..... 111 ..... 1111111 @r
dksub8          0001101 .....  ..... 111 ..... 1111111 @r
dksub16         0001001 .....  ..... 111 ..... 1111111 @r

# *** Nuclei N2 SIMD DSP Additional Instruction ***
dkhmx8          0000000 .....  ..... 000 ..... 1111011 @r
dkhmx16         0000001 .....  ..... 000 ..... 1111011 @r
dsmmul          0000010 .....  ..... 000 ..... 1111011 @r
dsmmulu         0000011 .....  ..... 000 ..... 1111011 @r
dkwmmul         0000100 .....  ..... 000 ..... 1111011 @r
dkwmmulu        0000101 .....  ..... 000 ..... 1111011 @r
dkabs32         0000110 00000  ..... 000 ..... 1111011 @r2
dkslra32        0000111 .....  ..... 000 ..... 1111011 @r
dkadd32         0001000 .....  ..... 000 ..... 1111011 @r
dksub32         0001001 .....  ..... 000 ..... 1111011 @r

# *** Nuclei N3 SIMD DSP Additional Instruction ***
dkmmac          0001010 .....  ..... 000 ..... 1111011 @r
dkmmacu         0001011 .....  ..... 000 ..... 1111011 @r
dkmmsb          0001100 .....  ..... 000 ..... 1111011 @r
dkmmsbu         0001101 .....  ..... 000 ..... 1111011 @r
